# Google Gemini API key (https://aistudio.google.com/apikey).
# Leave empty to run with the built-in rule-based analysis engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: preferred Gemini model (tried first, before the built-in fallbacks)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: comma-separated list of frontend origins allowed by CORS
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
